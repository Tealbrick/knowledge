{
  "schemaVersion": 1,
  "id": "tealbrick-knowledge",
  "version": "0.1.0",
  "distribution": "public-source-and-railway-template",
  "sourceContext": "standalone-repository-root",
  "dockerfile": "deploy/container/Dockerfile",
  "image": null,
  "imageStatus": "optional-public-image-not-required",
  "railwayBlueprint": "railway-blueprint.json",
  "port": 5310,
  "replicas": 1,
  "volume": {
    "mountPath": "/data",
    "contents": [
      "knowledge.sqlite",
      "knowledge-attachments",
      "model-settings.json",
      "instance-claim-identity.json",
      "authorization-audit.sqlite",
      "brain-extractions.sqlite",
      "brain-projections.sqlite",
      "research-writes.sqlite",
      "research-chat.sqlite",
      "gbrain-home"
    ]
  },
  "health": {
    "path": "/healthz",
    "authenticated": false,
    "meaning": "program-liveness-only"
  },
  "readiness": {
    "path": "/api/status",
    "authenticated": true,
    "check": "Inspect Brain and Research dependency posture separately; no all-features readiness promise"
  },
  "auth": {
    "header": "X-Knowledge-Instance-Token",
    "secretEnv": "KNOWLEDGE_INSTANCE_TOKEN",
    "minimumLength": 32,
    "scope": "entire-single-tenant-instance",
    "purpose": "operator-recovery-and-deployment-validation-only",
    "deliverToConnectedAgents": false,
    "researchHeader": "Authorization: Bearer <independently configured Knowledge principal token>"
  },
  "mcp": {
    "inImage": false,
    "adapterPackage": "@tealbrick/knowledge-agent",
    "adapterVersion": "0.1.0",
    "protocol": "stdio",
    "runsOn": "trusted customer agent host",
    "supportedOperations": [
      "knowledge_brain_tools",
      "knowledge_brain_call"
    ],
    "endpointEnv": "KNOWLEDGE_BASE_URL",
    "partitionEnv": "KNOWLEDGE_PARTITION_KEY",
    "credentialEnv": "KNOWLEDGE_SERVICE_TOKEN",
    "credentialType": "individually scoped Knowledge service-principal token",
    "networkPath": "customer agent host directly to Knowledge HTTPS endpoint",
    "sourceDocumentation": "../../adapters/agent/README.md"
  },
  "customerRuntimeAuth": {
    "authorizationHeader": "Authorization: Bearer <Knowledge service-principal token>",
    "principalConfigEnv": "KNOWLEDGE_SERVICE_PRINCIPALS",
    "partitionPolicy": "principal capability ceiling intersected with matching partition grant",
    "instanceTokenForAgents": false,
    "portalIntrospection": false,
    "revocation": "principal changes take effect at controlled Program restart",
    "sourceDocumentation": "../../docs/customer-runtime-auth.md"
  },
  "attachmentAuth": {
    "status": "legacy-optional",
    "portalEnv": "TEALBRICK_PORTAL_URL",
    "deploymentEnv": "TEALBRICK_DEPLOYMENT_ID",
    "companyEnv": "KNOWLEDGE_COMPANY_ID",
    "portalOrgEnv": "KNOWLEDGE_PORTAL_ORG_ID",
    "attachmentHeader": "Authorization: Bearer <attachment>",
    "agentHeader": "X-Tealbrick-Agent-Token",
    "capabilities": [
      "knowledge:documents:read",
      "knowledge:documents:write",
      "knowledge:brain:read"
    ],
    "revocation": "live portal introspection every operation",
    "tenantBoundary": "dedicated instance per workspace"
  },
  "agentTransport": "REST over HTTPS from trusted customer MCP or Eve adapter",
  "requiredEnv": [
    "KNOWLEDGE_INSTANCE_TOKEN"
  ],
  "environment": {
    "HOST": "0.0.0.0",
    "PORT": "5310",
    "NODE_ENV": "production",
    "KNOWLEDGE_DATA_DIR": "/data",
    "KNOWLEDGE_GBRAIN_HOME": "/data/gbrain-home",
    "KNOWLEDGE_GBRAIN_AUTOSTART": "true"
  },
  "researchRequiredEnv": [
    "KNOWLEDGE_OPEN_NOTEBOOK_BASE_URL",
    "KNOWLEDGE_OPEN_NOTEBOOK_TOKEN",
    "KNOWLEDGE_SERVICE_PRINCIPALS",
    "KNOWLEDGE_OPEN_NOTEBOOK_BINDINGS"
  ],
  "chatRequiredEnv": [
    "KNOWLEDGE_OPEN_NOTEBOOK_CHAT_MODEL_ID"
  ],
  "dependencies": [
    {
      "id": "gbrain",
      "version": "0.48.2.0",
      "commit": "5cfb84f1d3a809c70064c292c23db3d538d5c551",
      "mode": "bundled-bun-child-pglite",
      "public": false
    },
    {
      "id": "open-notebook",
      "image": "lfnovo/open_notebook:1.14.0@sha256:6c5fb35b6c60549e4c2dc7617d1f07aaf0a67c4954564a73498d536b8186e879",
      "platform": "linux/amd64",
      "port": 5055,
      "volume": "/app/data",
      "public": false
    },
    {
      "id": "surrealdb",
      "image": "surrealdb/surrealdb:v2.6.5@sha256:7db835aab6355b66e2b5779a3cddae811f201c417adadb4413310ae7f925110e",
      "platform": "linux/amd64",
      "port": 8000,
      "volume": "/mydata",
      "public": false
    }
  ],
  "limitations": [
    "The instance recovery secret is not agent authorization; direct agent requests are still partition- and capability-scoped",
    "Portal owner browser launch requires a live deployment binding; Research UI session grants remain separate",
    "Model provider credentials and models require separate provisioning",
    "No automatic notebook mapping provisioning",
    "No marketplace license enforcement inside image"
  ],
  "sourceBuild": {
    "repository": "https://github.com/Tealbrick/knowledge",
    "ref": "release/knowledge-v0.1.0-api-provenance.1",
    "refType": "branch",
    "releaseTag": "v0.1.0-api-provenance.1",
    "resolvedSourceSha": "ed71875f1a7d97bd2f20514019fc289cfce2b0db",
    "rootDirectory": "/",
    "dockerfilePath": "deploy/container/Dockerfile",
    "branchProtection": {
      "provider": "github",
      "requiredPullRequestReviews": 1,
      "enforceAdministrators": true,
      "allowForcePushes": false,
      "allowDeletions": false,
      "requiredLinearHistory": true,
      "lockBranch": true,
      "requiredConversationResolution": true
    },
    "build": "Railway builds the public repository in the customer project",
    "resolution": "Portal verifies the provider-resolved commit SHA before accepting deployment"
  },
  "optionalImage": null,
  "imageRegistry": "ghcr.io/tealbrick/knowledge",
  "imagePullPolicy": "optional",
  "registryAuth": "none",
  "buildContext": {
    "kind": "standalone-repository-root-or-allowlisted-export",
    "root": "repository root or disposable export directory",
    "exportCommand": "KNOWLEDGE_EXPORT_ONLY=1 sh deploy/container/build-local.sh",
    "contents": [
      "program/",
      "sidecars/gbrain/",
      "deploy/container/",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/",
      ".sdk/"
    ]
  }
}
